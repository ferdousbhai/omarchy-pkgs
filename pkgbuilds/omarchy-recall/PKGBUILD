# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
pkgname=omarchy-recall
pkgver=0.1.1
pkgrel=1
pkgdesc='Local semantic file search for Omarchy, with a CLI and bundled agent skill'
arch=('x86_64' 'aarch64')
url='https://github.com/ferdousbhai/omarchy-recall'
license=('MIT')
depends=('bash' 'python' 'python-gobject' 'gtk4' 'libadwaita' 'ffmpeg' 'poppler' 'libvips' 'gcc-libs' 'glibc' 'uv' 'xdg-utils' 'xdg-terminal-exec' 'systemd')
optdepends=('omarchy: native search panel and desktop setup' 'neovim: open source results at the matching line' 'mpv: open media at its matching interval')
options=('!debug' '!strip')
install=omarchy-recall.install
_release="https://github.com/ferdousbhai/omarchy-recall/releases/download/v${pkgver}"
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::${_release}/omarchy-recall-x86_64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::${_release}/omarchy-recall-aarch64.tar.gz")
sha256sums_x86_64=('d8757adc2cbe19a475e357beba7e99f488733101fcc62fdd7c41ed7fd343e64d')
sha256sums_aarch64=('70f57448d7e55cf5d37f613a43feef5e5e2f30b1fa980e5be8d03054053770bf')

check() {
  cd "$srcdir/omarchy-recall"
  target/release/recall --help >/dev/null
  python omarchy/cli.py --help >/dev/null
  python omarchy/cli.py skill | cmp - omarchy/skills/omarchy-recall/SKILL.md
  python -m unittest discover -s omarchy/tests -v
}

package() {
  cd "$srcdir/omarchy-recall"
  install -dm755 "$pkgdir/usr/lib/omarchy-recall"
  cp -a app omarchy scripts ocr target "$pkgdir/usr/lib/omarchy-recall/"
  # Keep bytecode out of the package; Python can cache in the user's cache.
  find "$pkgdir/usr/lib/omarchy-recall" -type d -name __pycache__ -prune -exec rm -rf {} +
  local command module
  for command in omarchy-recall omarchy-recall-client; do
    module=cli
    [[ $command == omarchy-recall-client ]] && module=client
    install -dm755 "$pkgdir/usr/bin"
    printf '#!/bin/sh\nexec /usr/bin/python3 /usr/lib/omarchy-recall/omarchy/%s.py "$@"\n' "$module" > "$pkgdir/usr/bin/$command"
    chmod 755 "$pkgdir/usr/bin/$command"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 omarchy/skills/omarchy-recall/SKILL.md "$pkgdir/usr/share/$pkgname/skills/omarchy-recall/SKILL.md"
}
