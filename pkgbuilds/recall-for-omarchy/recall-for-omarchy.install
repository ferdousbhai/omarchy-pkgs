post_install() {
  printf '\nRecall includes a CLI and bundled skill for coding agents.\n'
  printf 'Set up the native Omarchy panel, service and agent skill as your user:\n  recall setup --skip-ocr\n'
  printf 'Agent instructions without desktop setup:\n  recall skill install\n'
  printf 'Apple Silicon GPU: omarchy pkg add vulkan-asahi\n'
  printf 'Optional OCR: omarchy pkg add uv, then recall ocr\n'
  printf 'GPU diagnostics: recall doctor\n'
  printf 'Model downloads start when folders are selected. Optional OCR downloads its own assets. Personal files and indexes stay local.\n\n'
}
post_upgrade() {
  printf '\nRun recall setup --skip-ocr to update your per-user integration.\n\n'
}
